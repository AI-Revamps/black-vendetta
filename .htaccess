# Black Vendetta - serverinstellingen
#
# Werkt op Apache (verreweg de meeste shared webhosts). Draait je host op
# LiteSpeed, dan wordt dit bestand ook gelezen. Op nginx moet je de regels
# handmatig omzetten; vraag je host daarnaar.

# LET OP: in dit bestand mag alleen wat Apache in een .htaccess toestaat.
# <Directory>, <VirtualHost> en php_flag/php_value horen hier NIET thuis:
# daar breekt Apache op af met een 500 op de hele site.

# --- Mapinhoud niet tonen ------------------------------------------------
# Valt onder AllowOverride Indexes. Geeft je host daarvoor geen toestemming,
# dan levert deze regel een 500 op; haal hem dan weg.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# --- Standaardpagina ------------------------------------------------------
DirectoryIndex index.php index.html

# --- Gevoelige bestanden afschermen ---------------------------------------
# Databasedumps, logbestanden, versiebeheer en editor-backups.
<FilesMatch "(?i)\.(sql|sqlite|db|log|ini|md|bak|old|swp|dist|sample)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(\.|Thumbs\.db|composer\.(json|lock))">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Hier stond een <Directory "uploads">-blok met php_flag erin. Allebei fout:
# <Directory> mag niet in een .htaccess, en php_flag werkt alleen met mod_php,
# niet met PHP-FPM of CGI. Het gaf een 500 op de hele site. Er is bovendien
# geen map met geüploade bestanden — spelers uploaden niets.

# --- Caching van statische bestanden ----------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/gif              "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/jpeg             "access plus 30 days"
</IfModule>

# --- Compressie ---------------------------------------------------------------
# AddOutputFilterByType komt uit mod_filter, niet uit mod_deflate. Op een host
# met wel mod_deflate maar niet mod_filter gaf een controle op de verkeerde
# module een 500. Allebei nodig, dus allebei controleren.
<IfModule mod_filter.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript
    </IfModule>
</IfModule>

# --- Beveiligingsheaders --------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
